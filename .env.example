# Copia este fichero a .env y ajusta los valores. Nunca subas .env al repositorio.
# Guía de instalación en casa: docs/deployment/home.md

# PostgreSQL (Docker Compose). Genera una contraseña larga, p. ej.: openssl rand -hex 24
POSTGRES_USER=openfinance
POSTGRES_PASSWORD=cambia-esta-contraseña
POSTGRES_DB=openfinance

# --- Instalación con Docker Compose ---------------------------------------------------------
# Modo direct (por defecto): el navegador entra a nginx en OPENFINANCE_BIND:OPENFINANCE_PORT.
# 127.0.0.1 = solo este equipo. Para entrar desde el móvil u otro equipo de casa usa la IP
# del equipo en la red local (p. ej. 192.168.1.20) o 0.0.0.0, y entonces la cookie no puede
# ser Secure porque se entra por http: OPENFINANCE_SESSION_COOKIE_SECURE=false.
OPENFINANCE_BIND=127.0.0.1
OPENFINANCE_PORT=8080
# OPENFINANCE_SESSION_COOKIE_SECURE=false

# Modo caddy: HTTPS con dominio propio (requiere Docker Compose >= 2.24). Descomenta las dos
# líneas; Caddy publica los puertos 80 y 443, nginx deja de publicar el suyo y la cookie
# pasa a ser siempre Secure.
# COMPOSE_FILE=compose.yaml:compose.https.yaml
# OPENFINANCE_DOMAIN=finanzas.example.org

# --- API (desarrollo local sin Docker) ------------------------------------------------------
DATABASE_URL=postgresql+psycopg://openfinance:cambia-esta-contraseña@localhost:5432/openfinance
OPENFINANCE_ENVIRONMENT=development
OPENFINANCE_LOG_LEVEL=INFO
# Zona horaria del hogar: decide qué es «hoy» y el mes en curso
OPENFINANCE_TIMEZONE=Europe/Madrid
OPENFINANCE_CORS_ORIGINS=["http://localhost:5173"]
# Cookie Secure: por defecto activada en producción y desactivada en desarrollo.
OPENFINANCE_SESSION_TTL_DAYS=30

# Web (proxy de Vite hacia la API en desarrollo)
OPENFINANCE_API_URL=http://localhost:8000

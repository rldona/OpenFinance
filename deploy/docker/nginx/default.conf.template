# Plantilla: la imagen oficial de nginx la pasa por envsubst al arrancar y solo sustituye
# las variables de entorno definidas (aquí, OPENFINANCE_PROXY_MODE); $host, $remote_addr…
# quedan como variables de nginx.

limit_req_zone $binary_remote_addr zone=login:1m rate=10r/m;

server {
    listen 80;
    server_name _;

    # direct: el navegador llega aquí sin intermediarios.
    # caddy: todo llega por Caddy, que es quien sabe la IP real y si se entró por HTTPS.
    include /etc/nginx/snippets/proxy-${OPENFINANCE_PROXY_MODE}.conf;

    root /usr/share/nginx/html;
    client_max_body_size 6m;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # X-Forwarded-For se SOBRESCRIBE (nunca se añade a lo que mande el cliente): así la API
    # no puede ser engañada con una IP inventada para saltarse el límite de intentos.
    location = /api/v1/auth/login {
        limit_req zone=login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $of_proto;
    }

    location /api/ {
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $of_proto;
    }

    location = /health {
        proxy_pass http://api:8000;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $of_proto;
    }

    location / {
        try_files $uri /index.html;
    }
}

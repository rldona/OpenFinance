# Plantilla: la imagen oficial de nginx la pasa por envsubst al arrancar y solo sustituye
# las variables de entorno definidas (aquí, OPENFINANCE_PROXY_MODE); $host, $remote_addr…
# quedan como variables de nginx.

limit_req_zone $binary_remote_addr zone=login:1m rate=10r/m;

server {
    listen 80;
    server_name _;

    # direct: el navegador llega aquí sin intermediarios.
    # caddy: todo llega por Caddy, que es quien sabe la IP real y si se entró por HTTPS.
    include /etc/nginx/snippets/proxy-${OPENFINANCE_PROXY_MODE}.conf;

    root /usr/share/nginx/html;
    client_max_body_size 6m;
    index index.html;

    server_tokens off;
    include /etc/nginx/snippets/security-headers.conf;

    # Se comprime solo lo estático: las respuestas de la API (proxy) no, porque comprimir
    # respuestas con datos personales y texto de la petición abre la puerta a BREACH.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types text/plain text/css text/javascript application/javascript application/json
        application/manifest+json image/svg+xml;

    # X-Forwarded-For se SOBRESCRIBE (nunca se añade a lo que mande el cliente): así la API
    # no puede ser engañada con una IP inventada para saltarse el límite de intentos.
    location = /api/v1/auth/login {
        limit_req zone=login burst=5 nodelay;
        limit_req_status 429;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
        proxy_hide_header Cache-Control;
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $of_proto;
        # El mismo identificador en el log de nginx y en el de la API; el del cliente se ignora.
        proxy_set_header X-Request-ID $request_id;
    }

    location ^~ /api/ {
        include /etc/nginx/snippets/security-headers.conf;
        # Nada de la API se guarda en cachés del navegador ni de intermediarios.
        add_header Cache-Control "no-store" always;
        proxy_hide_header Cache-Control;
        proxy_pass http://api:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $of_proto;
        # El mismo identificador en el log de nginx y en el de la API; el del cliente se ignora.
        proxy_set_header X-Request-ID $request_id;
    }

    location = /health {
        proxy_pass http://api:8000;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $of_proto;
        # El mismo identificador en el log de nginx y en el de la API; el del cliente se ignora.
        proxy_set_header X-Request-ID $request_id;
    }

    # Los ficheros de /assets/ llevan un hash en el nombre: nunca cambian.
    location ^~ /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # El service worker, la página y el manifiesto se vuelven a pedir siempre (304 si no
    # cambian): así una versión nueva llega sin esperar a que caduque una caché.
    location = /sw.js {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    location = /manifest.webmanifest {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # Iconos: sin hash en el nombre, un día.
    location ~* \.(png|svg|ico)$ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=86400" always;
        try_files $uri =404;
    }

    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
